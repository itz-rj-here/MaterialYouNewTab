# Server Configuration
PORT=3000
NODE_ENV=development

# Optional: Weather API Key (if you want server-side WeatherAPI integration)
# Get a free key at https://www.weatherapi.com
WEATHER_API_KEY=

# CORS Configuration (optional, defaults to same-origin and common local dev origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
